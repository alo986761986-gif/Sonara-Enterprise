{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sonara-enterprise",
  "main": "cloudflare/modal-proxy.mjs",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,
  "keep_vars": true,
  "routes": [
    {
      "pattern": "api.sonaraenterprise.com",
      "custom_domain": true
    }
  ]
}
