{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sonara-enterprise",
  "main": "cloudflare/sonara-vocal-refinement-guard.mjs",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,
  "keep_vars": true,
  "vars": {
    "SONARA_YUE_WORKER_URL": "https://yue.sonaraenterprise.com"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__sonara_internal/*", "/sonara-video-ui-edge.js"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SONARA_JOB_STATE",
        "class_name": "SonaraJobState"
      },
      {
        "name": "SONARA_AUTH",
        "class_name": "SonaraAuthStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v19-durable-job-state-1",
      "new_sqlite_classes": ["SonaraJobState"]
    },
    {
      "tag": "v20-sonara-native-auth-1",
      "new_sqlite_classes": ["SonaraAuthStore"]
    }
  ],
  "routes": [
    {
      "pattern": "api.sonaraenterprise.com",
      "custom_domain": true
    },
    {
      "pattern": "sonaraenterprise.com/*",
      "zone_name": "sonaraenterprise.com"
    },
    {
      "pattern": "www.sonaraenterprise.com/*",
      "zone_name": "sonaraenterprise.com"
    }
  ]
}
