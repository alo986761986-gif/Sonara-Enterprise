{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sonara-enterprise",
  "main": "cloudflare/sonara-engine-v9-diagnostic-wrapper.mjs",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,
  "keep_vars": true,
  "routes": [
    {
      "pattern": "api.sonaraenterprise.com",
      "custom_domain": true
    },
    {
      "pattern": "sonaraenterprise.com/api/music/job/*",
      "zone_name": "sonaraenterprise.com"
    },
    {
      "pattern": "sonaraenterprise.com/api/modal/audio*",
      "zone_name": "sonaraenterprise.com"
    },
    {
      "pattern": "www.sonaraenterprise.com/api/music/job/*",
      "zone_name": "sonaraenterprise.com"
    },
    {
      "pattern": "www.sonaraenterprise.com/api/modal/audio*",
      "zone_name": "sonaraenterprise.com"
    }
  ]
}
