{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sonara-enterprise",
  "main": "cloudflare/sonara-studio-max-router.mjs",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,
  "keep_vars": true,
  "vars": {
    "ACESTEP_WORKER_URLS": "https://gain-herbs-showcase-archives.trycloudflare.com,https://serve-charter-establish-designs.trycloudflare.com"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SONARA_JOB_STATE",
        "class_name": "SonaraJobState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v19-durable-job-state-1",
      "new_sqlite_classes": ["SonaraJobState"]
    }
  ],
  "routes": [
    {
      "pattern": "api.sonaraenterprise.com",
      "custom_domain": true
    },
    {
      "pattern": "sonaraenterprise.com/assets/index-*",
      "zone_name": "sonaraenterprise.com"
    },
    {
      "pattern": "www.sonaraenterprise.com/assets/index-*",
      "zone_name": "sonaraenterprise.com"
    },
    {
      "pattern": "sonaraenterprise.com/*",
      "zone_name": "sonaraenterprise.com"
    },
    {
      "pattern": "www.sonaraenterprise.com/*",
      "zone_name": "sonaraenterprise.com"
    }
  ]
}