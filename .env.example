# Public Firebase web configuration (Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin: one-line JSON service account used only by server routes
FIREBASE_SERVICE_ACCOUNT_JSON=
SONARA_FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# Stripe server-only configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=
STRIPE_AUTOMATIC_TAX=false

# SONARA Video AI (server-only)
# Primary provider: Google Gemini API / Veo 3.1.
# Never expose these values as VITE_* variables.
GEMINI_API_KEY=
# Optional override. By default SONARA uses Veo 3.1 Lite for Free and Veo 3.1 Fast for Creator/Studio.
SONARA_VIDEO_MODEL=

# Required legal documents. Checkout remains disabled until the final review flag is true.
SONARA_LEGAL_PUBLISH_READY=false
SONARA_LEGAL_VERSION=
SONARA_TERMS_URL=
SONARA_PRIVACY_URL=

# Public data printed on /terms and /privacy (these values are visible to visitors)
VITE_LEGAL_OPERATOR_NAME=
VITE_LEGAL_OPERATOR_TAX_ID=
VITE_LEGAL_OPERATOR_ADDRESS=
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_COUNTRY=Italia
VITE_LEGAL_EFFECTIVE_DATE=24 agosto 2026
VITE_LEGAL_VERSION=2026-08-24-v1

# Billing and generation protection
SONARA_APP_URL=https://sonaraenterprise.com
SONARA_ENGINE_API_URL=https://api.sonaraenterprise.com
BILLING_ENFORCEMENT_MODE=observe
SONARA_INTERNAL_PROXY_SECRET=
