# Public Firebase web configuration (Vite)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin: one-line JSON service account used only by server routes
FIREBASE_SERVICE_ACCOUNT_JSON=
SONARA_FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=

# Stripe server-only configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=
STRIPE_AUTOMATIC_TAX=false

# SONARA Music AI primary provider (server-only)
# Eleven Music v2 is the production engine. Never expose this key as VITE_*.
SONARA_MUSIC_PROVIDER=eleven_music
ELEVENLABS_API_KEY=
# Optional output override. Default: mp3_48000_192
ELEVEN_MUSIC_OUTPUT_FORMAT=mp3_48000_192

# SONARA Video AI (server-only)
# Primary provider: MoLab Wan 2.2 on the RTX Pro 6000 Blackwell notebook.
# Never expose these values as VITE_* variables.
SONARA_MOLAB_VIDEO_URL=
SONARA_MOLAB_VIDEO_TOKEN=
SONARA_MOLAB_VIDEO_MODEL=wan2.2-ti2v-5b
SONARA_MOLAB_VIDEO_FRAMES=97
SONARA_MOLAB_VIDEO_STEPS=12
# Server-only owner account used for the private Video AI credit override.
SONARA_OWNER_EMAIL=
# Optional fallbacks: Google Gemini API / Vertex AI.
GEMINI_API_KEY=
# Optional failover: run Vertex AI on a Google Cloud project separate from Firebase.
SONARA_VERTEX_PROJECT_ID=
SONARA_VERTEX_SERVICE_ACCOUNT_JSON=
# Optional override. By default SONARA uses Veo 3.1 Lite for Free and Veo 3.1 Fast for Creator/Studio.
SONARA_VIDEO_MODEL=

# Required legal documents. Checkout remains disabled until the final review flag is true.
SONARA_LEGAL_PUBLISH_READY=false
SONARA_LEGAL_VERSION=
SONARA_TERMS_URL=
SONARA_PRIVACY_URL=

# Public data printed on /terms and /privacy (these values are visible to visitors)
VITE_LEGAL_OPERATOR_NAME=
VITE_LEGAL_OPERATOR_TAX_ID=
VITE_LEGAL_OPERATOR_ADDRESS=
VITE_LEGAL_CONTACT_EMAIL=
VITE_LEGAL_COUNTRY=Italia
VITE_LEGAL_EFFECTIVE_DATE=24 agosto 2026
VITE_LEGAL_VERSION=2026-08-24-v1

# Billing and generation protection
SONARA_APP_URL=https://sonaraenterprise.com
SONARA_ENGINE_API_URL=https://api.sonaraenterprise.com
BILLING_ENFORCEMENT_MODE=observe
SONARA_INTERNAL_PROXY_SECRET=

# SONARA YuE fallback only (server-only / Cloudflare Worker secret or variable)
# Kept only as a private fallback. Eleven Music v2 is the primary production engine.
SONARA_YUE_WORKER_URL=
SONARA_YUE_API_KEY=
