{
  "version": "sonara-physical-realism-lora-v1.1",
  "base_model": "acestep-v15-xl-turbo",
  "training_tool": "ACE-Step 1.5 official training API (MIT)",
  "activation_tag": "<SONARA_PHYSICAL_REALISM>",
  "legal_policy": {
    "allowed_license_types": [
      "OWNED",
      "EXPLICITLY_LICENSED",
      "CC0_PUBLIC_DOMAIN"
    ],
    "require_rights_to_train": true,
    "synthetic_audio_allowed_for_development": true,
    "synthetic_audio_allowed_for_promotion": false,
    "cc0_public_domain_allowed": true,
    "cc0_note": "CC0/public-domain material is accepted when source provenance and source license evidence are recorded."
  },
  "dataset_policy": {
    "development_min_tracks": 8,
    "promotion_min_tracks": 50,
    "supported_audio_formats": [
      ".wav",
      ".flac",
      ".mp3",
      ".ogg",
      ".opus",
      ".m4a"
    ],
    "required_families": [
      "acoustic-drums",
      "piano-keys",
      "guitars-fretted",
      "bass",
      "bowed-strings",
      "brass-woodwinds"
    ],
    "max_single_family_share": 0.4,
    "goal": "recorded human performances with natural articulation, room continuity, dynamics and physical playability"
  },
  "training": {
    "mode": "official-api",
    "adapter_type": "lora",
    "model_variant": "turbo",
    "rank": 64,
    "alpha": 128,
    "dropout": 0.1,
    "learning_rate": 0.0001,
    "optimizer": "AdamW",
    "save_every_epochs": 10,
    "seed": 42,
    "epochs_by_dataset_size": [
      {
        "max_tracks": 10,
        "epochs": 300
      },
      {
        "max_tracks": 50,
        "epochs": 150
      },
      {
        "max_tracks": null,
        "epochs": 75
      }
    ],
    "endpoint": "/v1/training/start",
    "preprocess_endpoint": "/v1/dataset/preprocess",
    "status_endpoint": "/v1/training/status",
    "export_endpoint": "/v1/training/export"
  },
  "inference": {
    "shift": 3,
    "inference_steps": 8,
    "adapter_scale_start": 0.75,
    "adapter_scale_max": 1
  },
  "promotion": {
    "requires_real_adapter_safetensors": true,
    "requires_adapter_config": true,
    "reject_legacy_adapter_model_bin": true,
    "requires_benchmark": "engine/sonara_benchmark_v1.json",
    "requires_dataset_promotion_eligibility": true,
    "benchmark_status_required": "PASS"
  },
  "research_only_tools": [
    "Side-Step 1.1.2-beta (CC BY-NC-SA 4.0; not approved for SONARA commercial production without separate permission)"
  ]
}
