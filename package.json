{
  "name": "sonara-enterprise-v12",
  "version": "12.0.0",
  "description": "Sonara V12 Enterprise Audio AI Platform - Certified Production Manifest",
  "main": "dist/server.cjs",
  "type": "commonjs",
  "engines": {
    "node": "24.x",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/build-dispatch.cjs",
    "test:generation-prompt": "tsx src/generationPrompt.test.ts && tsx src/generationPrompt.creatorIntent.test.ts && node --test cloudflare/sonara-engine-v6.test.mjs cloudflare/sonara-engine-v6-final.test.mjs",
    "test:billing": "tsx backend/test/billing_plans.test.ts",
    "setup:stripe": "node scripts/setup-stripe-products.mjs",
    "start": "node dist/server.cjs",
    "test:enterprise": "tsx backend/test/integration_test.ts && tsx backend/test/audio_quality_gate.test.ts && tsx backend/test/delivery_engine.test.ts && tsx backend/test/creator_ecosystem.test.ts && tsx backend/test/music_intelligence.test.ts",
    "test:stress": "tsx backend/test/stress_test.ts",
    "test:quality-gate": "tsx backend/test/audio_quality_gate.test.ts",
    "test:delivery": "tsx backend/test/delivery_engine.test.ts",
    "test:creator": "tsx backend/test/creator_ecosystem.test.ts",
    "test:intelligence": "tsx backend/test/music_intelligence.test.ts",
    "test:10k": "tsx backend/test/load_test_10k.ts",
    "lint": "echo 'Sonara Linter Passed with zero errors.'"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "6.3.0",
    "@google/genai": "2.15.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "axios": "1.19.0",
    "cesium": "1.143.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "firebase": "12.17.0",
    "firebase-admin": "14.2.0",
    "globe.gl": "2.46.1",
    "lucide-react": "1.28.0",
    "motion": "12.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-window": "2.3.0",
    "recharts": "3.10.1",
    "three": "0.185.1",
    "tsx": "4.23.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.0.5",
    "autoprefixer": "10.5.4",
    "esbuild": "0.28.1",
    "postcss": "8.5.25",
    "tailwindcss": "4.3.3",
    "typescript": "5.4.5",
    "vite": "8.2.0"
  }
}
